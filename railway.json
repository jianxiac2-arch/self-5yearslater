{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "pythonVersion": "3.12"
  },
  "deploy": {
    "startCommand": "python -m app.seed && uvicorn app.main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/health",
    "restartPolicy": "on_failure"
  }
}
