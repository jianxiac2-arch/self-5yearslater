# ===== DeepSeek API =====
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat

# ===== Embedding =====
# 本地开发：不设 EMBEDDING_API_URL，用本地 BGE-small-zh（首次自动下载）
# 生产部署：设 EMBEDDING_API_URL 为 DeepSeek Embedding API，免本地模型
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_API_URL=https://api.deepseek.com/v1/embeddings
# EMBEDDING_API_KEY=your_deepseek_api_key_here
# EMBEDDING_API_MODEL=text-embedding-v1

# ===== 数据存储路径 =====
# Railway: 设 CHROMA_PATH=/data/chroma 和 DB_PATH=/data/memory.db
# DB_PATH=
# CHROMA_PATH=

# ===== 服务端口 =====
PORT=8000

# ===== 前端地址（CORS） =====
# Railway 部署后改成 Vercel 的域名，如 FRONTEND_ORIGIN=https://5yl.vercel.app
FRONTEND_ORIGIN=http://localhost:5173
